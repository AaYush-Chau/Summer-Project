{
  "compilerOptions": {
     "rootDir": "./",
     "outDir": "./dist",

     "module": "ES2022",
     "target": "ES2020",
     "types": ["node"],
     "lib": ["ES2020"],
     "moduleResolution": "bundler",

     "strict": true, 
     "esModuleInterop": true,
     "allowJs": true,
     "isolatedModules": true,
     "skipLibCheck": true,
     "sourceMap": true, 
     "resolveJsonModule": true, 
     "forceConsistentCasingInFileNames": true,
     "ignoreDeprecations": "6.0",
     "pretty": true
   },
   "include": ["src/**/*"],
   "exclude": ["node_modules", "./dist"]
}